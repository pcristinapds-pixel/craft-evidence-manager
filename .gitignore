* - Histórico de execuções.html
* - Bug (*.html
Bugs/
exec-*/
cenario.json
historia.json
*.tmp

# Vídeos gravados / editados
*.mp4
*.webm
*.mov
*.mkv
*.avi

# Mantém o vídeo de exemplo usado pelo "npm run test:ppt"
!assets/exemplo/video.mp4

